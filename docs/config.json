{
  "$schema": "https://raw.githubusercontent.com/Omena0/fr-docs/main/docs/config.schema.json",
  "project_name": "Fr-docs",
  "project_url": "https://github.com/Omena0/fr-docs",
  "copyright_holder": "Omena0",
  "docs_dir": ".",
  "site_path_prefix": "/fr-docs",
  "sidebar": [
    ["Getting started", [
      ["index", "Home"],
      ["installation", "Installation"],
      ["quickstart", "Quickstart"],
      ["config.json", "Configuration"],
      ["showcase", "Showcase"]
    ]]
  ],
  "build": {
    "workers": 1,
    "minify_html": true,
    "optimize_html": true,
    "zstd_level": 22,
    "search_index_filename": "search_index.zst",
    "git_meta_filename": "git_meta.zst"
  },
  "versioning": {
    "commit_message_pattern": "^\\s*([0-9]+[A-Za-z])\\s*[-:—–]\\s*(.+)",
    "live_label": "Live"
  },
  "features": {
    "backlinks": true,
    "related": true,
    "auto_link": true,
    "versioning": true,
    "search": {
      "enabled": true,
      "include": {
        "pages": true,
        "titles": true,
        "headings": true,
        "content": true,
        "symbols": true,
        "files": true
      }
    },
    "code_references": true,
    "link_preview": true,
    "code_highlighting": true,
    "blockquotes": true,
    "ext_tags": true
  }
}
